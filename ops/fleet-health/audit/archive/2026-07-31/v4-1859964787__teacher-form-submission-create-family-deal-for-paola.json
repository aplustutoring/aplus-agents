        "subject": "New family nomination: {{ enrolled_object.first_name }} {{ enrolled_object.last_name }}",
        "body": "A new family has been nominated and needs outreach.\n\nFamily: {{ enrolled_object.first_name }} {{ enrolled_object.last_name }}\nNew family deal: https://app.hubspot.com/contacts/6312752/record/0-3/{{ action_outputs.action_output_2.hs_created_object.hs_object_id }}"
      },
      "type": "SINGLE_CONNECTION"
    },
    {
      "actionId": "5",
      "secretNames": [
        "Secret"
      ],
      "sourceCode": "const hubspot = require('@hubspot/api-client');\n\nexports.main = async (event, callback) => {\n  const familyDealId = event.inputFields['familyDealId'];\n  const teacherDealId = event.inputFields['teacherDealId'];\n  const token = process.env.Secret;\n\n  if (!familyDealId || !teacherDealId) {\n    throw new Error('Missing familyDealId or teacherDealId');\n  }\n\n  const client = new hubspot.Client({ accessToken: token });\n\n  try {\n    // 1. Link teacher deal <-> family deal (custom label, ID 7)\n    await client.apiRequest({\n      method: 'PUT',\n      path: `/crm/v4/objects/0-3/${teacherDealId}/associations/0-3/${familyDealId}`,\n      body: [{ associationCategory: 'USER_DEFINED', associationTypeId: 7 }]\n    });\n\n    // 2. Get the contact(s) on the teacher deal\n    const contactsResp = await client.apiRequest({\n      method: 'GET',\n      path: `/crm/v4/objects/0-3/${teacherDealId}/associations/0-1`\n    });\n    const contactsBody = await contactsResp.json();\n    const contactResults = contactsBody.results || [];\n\n    // 3. Associate each contact to the new family deal (default deal<->contact type, ID 3)\n    for (const c of contactResults) {\n      const contactId = c.toObjectId;\n      await client.apiRequest({\n        method: 'PUT',\n        path: `/crm/v4/objects/0-3/${familyDealId}/associations/0-1/${contactId}`,\n        body: [{ associationCategory: 'HUBSPOT_DEFINED', associationTypeId: 3 }]\n      });\n    }\n\n    callback({\n      outputFields: {\n        associationResult: 'success',\n        contactsLinked: contactResults.length\n      }\n    });\n  } catch (err) {\n    console.error('Association failed:', err.message);\n    callback({\n      outputFields: {\n        associationResult: 'error',\n        errorMessage: err.message\n      }\n    });\n  }\n};",
      "runtime": "NODE20X",
