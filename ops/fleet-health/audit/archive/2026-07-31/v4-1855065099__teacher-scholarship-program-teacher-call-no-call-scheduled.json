    {
      "actionId": "18",
      "secretNames": [
        "Secret"
      ],
      "sourceCode": "const hubspot = require('@hubspot/api-client');\n\nexports.main = async (event, callback) => {\n  const dealId = event.inputFields['deal_id'];\n  const contactId = event.inputFields['contact_record_id'];\n\n  if (!dealId) {\n    callback({\n      outputFields: {\n        copy_status: 'Missing deal ID',\n        copied_meeting_date: ''\n      }\n    });\n    return;\n  }\n\n  if (!contactId) {\n    callback({\n      outputFields: {\n        copy_status: 'No associated contact record ID on deal',\n        copied_meeting_date: ''\n      }\n    });\n    return;\n  }\n\n  const client = new hubspot.Client({ accessToken: process.env.Secret });\n\n  try {\n    const contactResponse = await client.crm.contacts.basicApi.getById(\n      contactId,\n      ['engagements_last_meeting_booked']\n    );\n\n    const meetingDate = contactResponse.properties.engagements_last_meeting_booked;\n\n    if (!meetingDate) {\n      callback({\n        outputFields: {\n          copy_status: 'Contact has no booked meeting date',\n          copied_meeting_date: ''\n        }\n      });\n      return;\n    }\n\n    await client.crm.deals.basicApi.update(dealId, {\n      properties: {\n        teacher_scholarship_meeting_date: meetingDate\n      }\n    });\n\n    callback({\n      outputFields: {\n        copy_status: 'Updated deal meeting date',\n        copied_meeting_date: meetingDate\n      }\n    });\n  } catch (err) {\n    console.error(err.message);\n    callback({\n      outputFields: {\n        copy_status: `Error: ${err.message}`,\n        copied_meeting_date: ''\n      }\n    });\n  }\n};",
      "runtime": "NODE20X",
